' ARQUIVO CONSOLIDADO DE REVISÃO DO BANCO — requisitos v2.2.
' Preserva entidades, atributos e relações de DER/01..07 e seu dicionário.
' Não executar SQL a partir deste arquivo sem refinamento físico e revisão.
' A_DEFINIR = tipo ainda não estabelecido na origem; não é tipo PostgreSQL.
' Atributos agrupados na origem foram separados; não se inferiu tipo de enum/data/número.
' UUID para IDs e FKs é convenção explícita do esboço; demais tipos só quando declarados.
' FK nula/opcional é indicada em comentário; a coluna cliente_id é sempre NOT NULL.
' FKs operacionais são compostas com cliente_id para impedir relações entre tenants.
' Prefeitura = cliente; secretaria = unidade; município = geografia.
' Concessão por unidade/finalidade; compartilhamento interno precisa de aprovação.
' Em autorrelacionamentos, extremos: origem e destino, respectivamente.

entity "cliente" as E_cliente {
  "id" as F_cliente_id : UUID <<key>>
  "tipo" as F_cliente_tipo : A_DEFINIR
  "nome" as F_cliente_nome : A_DEFINIR
  "status" as F_cliente_status : A_DEFINIR
  "fuso_horario" as F_cliente_fuso_horario : A_DEFINIR
  "criado_em" as F_cliente_criado_em : A_DEFINIR
}
' cliente: Origem: id : uuid PK
' cliente: Origem: tipo : PREFEITURA (demais tipos dependem de habilitação)
' cliente: Origem: nome / status / fuso_horario / criado_em

entity "prefeitura" as E_prefeitura {
  "cliente_id" as F_prefeitura_cliente_id : UUID <<key>>
  ' FK cliente_id -> cliente.id; obrigatório
  "municipio_id" as F_prefeitura_municipio_id : UUID
  ' FK municipio_id -> municipio.id; obrigatório
  "nome_oficial" as F_prefeitura_nome_oficial : A_DEFINIR
  "identificador_institucional" as F_prefeitura_identificador_institucional : A_DEFINIR
}
' prefeitura: Origem: cliente_id : uuid PK, FK cliente
' prefeitura: Origem: municipio_id : uuid FK município (geografia)
' prefeitura: Origem: nome_oficial / identificador_institucional opcional
' prefeitura: UNIQUE(cliente_id); identidade contratual não deriva do código IBGE

