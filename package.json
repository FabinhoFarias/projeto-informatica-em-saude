{
  "name": "vigia-plus",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e .env.local -- next dev",
    "build": "next build",
    "start": "next start",
    "lint": "node scripts/quality.mjs lint",
    "lint:check": "node scripts/quality.mjs lint",
    "typecheck": "node scripts/quality.mjs typecheck",
    "format": "node scripts/quality.mjs format",
    "format:check": "node scripts/quality.mjs format:check",
    "test:unit": "node scripts/quality.mjs test",
    "quality": "node scripts/quality.mjs",
    "remove-cache": "node -e \"require('fs').rmSync('.next', { recursive: true, force: true })\"",
    "git:reset-hard": "git fetch origin && git reset --hard origin/main",
    "git:pull-keep": "git stash && git pull && git stash pop",
    "git:config-me": "git config user.name \"Fabinho Farias\" && git config user.email \"fjcff@cin.ufpe.br\"",
    "git:deploy": "npm run build && git add . && git commit -m",
    "git:push": "git push -u origin main",
    "git:push-force": "git push -f origin main",
    "dev:python": "python -m uvicorn app.api.python.index:app --reload --port 8000",
    "build:integrations": "prisma generate && NODE_OPTIONS=--max-old-space-size=1536 ./node_modules/.bin/next build && node scripts/update-progress.js",
    "app:streamlit": "cd arquivosPython && python -m streamlit run app.py",
    "postinstall": "node -e \"if (require('fs').existsSync('prisma/schema.prisma')) require('child_process').execFileSync('prisma', ['generate'], { stdio: 'inherit' })\"",
    "progress": "node scripts/update-progress.js",
    "//": "--- Scripts de Ambiente ---",
    "test:studio": "dotenv -e .env.local -- npx prisma studio",
    "test:migrate": "dotenv -e .env.local -- npx prisma migrate dev",
    "prod:studio": "dotenv -e .env.production -- npx prisma studio",
    "financeiro:configurar-plataforma": "node scripts/configurar-plataforma-principal.mjs",
    "prod:dev": "dotenv -e .env.production -- next dev",
    "db:push:prod": "dotenv -e .env.production -- npx prisma db push",
    "db:push:test": "dotenv -e .env.local -- npx prisma db push",
    "count-lines": "rg --files --hidden -0 -g !node_modules -g !.next -g !.git | xargs -0 wc -l",
    "test": "node testes/main.mjs"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "read-excel-file": "^9.3.12"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "prettier": "3.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
