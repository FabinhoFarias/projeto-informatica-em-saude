{
  "name": "denguinhos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "remove-cache": "node -e \"require('fs').rmSync('.next', { recursive: true, force: true })\"",
    "git:reset-hard": "git fetch origin && git reset --hard origin/main",
    "git:pull-keep": "git stash && git pull && git stash pop",
    "git:config-me": "git config user.name \"Fabinho Farias\" && git config user.email \"fjcff@cin.ufpe.br\"",
    "git:deploy": "npm run build && git add . && git commit -m",
    "git:push": "git push -u origin main",
    "git:push-force": "git push -f origin main"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "read-excel-file": "^9.3.12"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
