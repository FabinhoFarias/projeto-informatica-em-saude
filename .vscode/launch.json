      "program": "${workspaceFolder}/scripts/extrair-sinan-dengue.py",
      "args": ["--ano-inicial", "2000", "--ano-final", "2026", "--threads", "20"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
