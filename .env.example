# Chave restrita no Google Cloud para Maps JavaScript API.
# Restrinja por domínio (produção) e por APIs: Maps JavaScript API.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# API server-side consumida pelas páginas do Next.js.
# Em produção, use a URL HTTPS pública da API; nunca localhost.
API_BASE_URL=http://localhost:4000

# Segredos da API. Gere valores diferentes para desenvolvimento e produção.
SENHA_DEMO=
API_JWT_SECRET=
API_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
